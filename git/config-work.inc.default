# Work identity. Copy to config-work.inc and fill in.
# signingkey and the sshCommand key are 1Password SSH public keys.
# See the Git Configuration section in README.md for the 1Password setup.
# [user]
#     name = Your Name
#     email = you@work.example
#     signingkey = ssh-ed25519 AAAA...
# Pin the auth key so this folder never offers the personal key.
# The .pub must exist on disk (export it from 1Password).
# [core]
#     sshCommand = ssh -o IdentitiesOnly=yes -i ~/.ssh/github-work.pub
# [gpg]
#     format = ssh
# [gpg "ssh"]
#     program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
# [commit]
#     gpgsign = true
